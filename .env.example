# ============================================================
# Variables de Entorno — Grafo de Conocimiento Histórico Cusco
# ============================================================
# Copia este archivo como '.env' y completa con tus credenciales:
#   copy .env.example .env

# --- Google Gemini API (Obligatorio para el extractor LLM) ---
# Obtén tu clave gratuita en: https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_clave_de_gemini_aqui

# --- Neo4j Database (Local Desktop o AuraDB en la nube) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=tu_password_de_neo4j
